{
  "name": "@the-south-pacific/ns-dispatch-tools",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "nx run-many -t build",
    "check": "nx run-many -t lint typecheck && nx format:check",
    "check:types": "nx run-many -t typecheck",
    "check:format": "nx format:check",
    "check:lint": "nx run-many -t lint",
    "fix": "nx run-many -t lint --fix && nx format:write",
    "fix:format": "nx format:write",
    "fix:lint": "nx run-many -t lint --fix",
    "test": "nx run-many -t test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/vite": "23.2.1",
    "@nx/vitest": "23.2.1",
    "@nx/web": "23.2.1",
    "@types/node": "24.13.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.11.0",
    "jiti": "2.4.2",
    "jsonc-eslint-parser": "^2.4.2",
    "nx": "23.2.1",
    "prettier": "3.9.8",
    "tslib": "^2.8.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "verdaccio": "6.4.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.1"
    }
  },
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      }
    }
  }
}
